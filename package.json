{
  "name": "lantern-summit",
  "version": "0.1.0",
  "private": true,
  "description": "Lantern Summit: original 6x5 pay-anywhere tumbling slot prototype (demo credits only)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "sim": "esbuild sim/simulate.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.sim/simulate.mjs && node .sim/simulate.mjs",
    "server": "tsx server/server.ts",
    "test": "esbuild sim/selftest.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.sim/selftest.mjs && node .sim/selftest.mjs",
    "server:lan": "HOST=0.0.0.0 tsx server/server.ts"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vite-plugin-singlefile": "2.2.0"
  }
}
